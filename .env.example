# Supabase (get these from https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server
PORT=3000
MAX_UPLOAD_MB=16384
ROOM_IDLE_MINUTES=30

# Optional: where cloudflared.exe is, if `npm run share` can't find it
# CLOUDFLARED_PATH=C:\Program Files (x86)\cloudflared\cloudflared.exe

# Optional: FFmpeg for smooth mode, if it isn't found automatically
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe

# Optional: TURN relay for voice chat on networks that block direct connections
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
